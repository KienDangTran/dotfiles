[submodule "antigen"]
	path = antigen
	url = https://github.com/zsh-users/antigen.git
	ignore = dirty
[submodule "dotbot"]
	path = dotbot
	url = https://github.com/anishathalye/dotbot
	ignore = dirty
[submodule "dotbot-brewfile"]
	path = dotbot-brewfile
	url = https://github.com/sobolevn/dotbot-brewfile.git
	ignore = dirty
[submodule "dotbot-apt"]
	path = dotbot-apt
	url = https://github.com/bryant1410/dotbot-apt
[submodule "dotbot-dnf"]
	path = dotbot-dnf
	url = https://github.com/rbrauner/dotbot-dnf.git
